# ============================================================
# .env.example — 环境变量配置示例
# 复制此文件为 .env 并填入真实值，切勿将 .env 提交到代码仓库！
# ============================================================

# ---- Cloudflare R2 存储配置 --------------------------------
# R2 Account ID（在 Cloudflare 控制台右侧边栏可找到）
R2_ACCOUNT_ID=your_cloudflare_account_id_here

# R2 Access Key ID（在 R2 → Manage R2 API Tokens 中生成）
R2_ACCESS_KEY_ID=your_r2_access_key_id_here

# R2 Secret Access Key（生成 Token 时一次性展示，请妥善保存）
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key_here

# R2 存储桶名称
R2_BUCKET_NAME=omnisync-data

# R2 公开访问 URL（用于前端直接读取文件，需在控制台开启 Public Access）
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# 上传的二进制报告文件名
R2_REPORT_FILENAME=latest_threat_report.bin


# ---- AutoDL API 配置 ----------------------------------------
# AutoDL API Token（在 AutoDL 个人中心 → API 管理 中获取）
# 注意：此值同样需要在 GitHub 仓库 Settings → Secrets → Actions 中
# 添加为 Secret，名称为 AUTODL_TOKEN
AUTODL_TOKEN=your_autodl_api_token_here

# AutoDL 实例 ID
AUTODL_INSTANCE_ID=97b911b700-0e555342


# ---- GitHub Actions 相关（仅本地调试用）----------------------
# 以下变量在 GitHub Actions 中通过 Secrets 自动注入，
# 本地调试脚本时可在此填写，但请确保 .env 已加入 .gitignore
GITHUB_TOKEN=your_github_personal_access_token_here
